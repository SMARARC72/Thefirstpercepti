{
  "name": "@first-perception/llm-client",
  "version": "2.0.0",
  "description": "LLM client for procedural narrative generation: Kimi/Moonshot API, prompt pipeline, safety, caching.",
  "type": "module",
  "main": "./dist/index.js",
