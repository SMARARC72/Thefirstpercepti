    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "tone": "^15.0.4",
    "@first-perception/types": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
