{
  "name": "@first-perception/audio",
  "version": "2.0.0",
  "description": "Generative audio system using Web Audio API and Tone.js.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
