    "tone": "^15.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "happy-dom": "^20.9.0",
    "playwright": "^1.60.0",
    "typescript": "^5.8.3",
