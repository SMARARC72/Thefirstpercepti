# Copy this file to .env.local (which is gitignored) and fill in real
# values. For Vercel deployments, set these in Project Settings → Env Vars.
#
# Postgres connection strings (required for server-side API routes).
# In Vercel + Supabase / Vercel Postgres / Neon, both are provided
# automatically when you attach the integration.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Optional Supabase service-side keys. Only needed if/when we replace the
# direct pg driver with the Supabase JS client. Leave blank otherwise.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider keys. The /api/llm proxy (Phase 3c) reads these server-side
# so they are never exposed in the browser bundle.
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=

# Optional: Sentry DSN, configured in Phase 7.
SENTRY_DSN=
