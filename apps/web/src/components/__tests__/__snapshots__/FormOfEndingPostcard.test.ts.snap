exports[`FormOfEndingPostcard — render > snapshot — X.13 unmaking postcard with full chrome 1`] = `"<article class="form-of-ending-postcard letter" role="article" aria-label="Form of Ending — Self-Unmaking — postcard" data-testid="form-of-ending-postcard" data-ending-kind="X13_ruin_unmaking" data-ending-tag="X.13"><header class="postcard-head"><p class="eb postcard-stamp" data-testid="postcard-stamp">DAY 14 · SCENE 9 · X.13</p><h2 class="postcard-title">Form of Ending — Self-Unmaking</h2><p class="postcard-greeting">For the record. Khojen —</p></header><div class="postcard-body" data-testid="postcard-body"><p class="postcard-line">You stand at the edge of the dry fountain.</p><p class="postcard-line">You speak the unmaking once.</p><p class="postcard-line">The room records the unmaking.</p><p class="postcard-line">She is no longer Khojen.</p></div><aside class="postcard-gutter" data-testid="postcard-gutter">— contradiction-ledger entry: ledger-entry-bell-court-E0099</aside><footer class="postcard-footer row"><span class="postcard-voice" data-testid="postcard-voice" data-voice-shift-applied="true">voice shifted · 2nd → 3rd</span><button type="button" class="btn ghost postcard-export" data-testid="postcard-export">Export to journal</button><button type="button" class="btn postcard-continue" data-testid="postcard-continue">Continue to legacy</button></footer></article>"`;
